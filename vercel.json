{
  "version": 2,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**",
          "public/**",
          "node_modules/semver/**",
          "node_modules/jsonwebtoken/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}

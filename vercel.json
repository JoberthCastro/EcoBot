{
  "version": 2,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build && node scripts/copy-public-to-root.js",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/**",
          "node_modules/semver/**",
          "node_modules/jsonwebtoken/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "/logo.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
